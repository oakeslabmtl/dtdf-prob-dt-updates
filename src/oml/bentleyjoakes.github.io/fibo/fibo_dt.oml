description <https://bentleyjoakes.github.io/fibo/fibo_dt#> as fibo {

	uses <https://bentleyjoakes.github.io/DTDF/vocab/DTDFVocab#> as DTDFVocab
	
	extends <https://bentleyjoakes.github.io/DTDF/desc/baseDesc#> as baseDesc
	extends <https://bentleyjoakes.github.io/fibo/fibo_pt#> as pt
	uses <https://bentleyjoakes.github.io/DTDF/vocab/base#> as base
	
	instance fibo_dt : DTDFVocab:DigitalTwin [
		DTDFVocab:purpose "enhance the functionality of the PT through the DT services"
		DTDFVocab:multiplicity 1
	]
	
	// SERVICES
	
	instance virtual_moisture_detector : DTDFVocab:Service [
		DTDFVocab:provides alerts
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:hasImplementation baseDesc:active
	]
	instance empty_hoppers_detector : DTDFVocab:Service [
		DTDFVocab:provides empty_hoppers_alert
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance cement_stuck_detector : DTDFVocab:Service [
		DTDFVocab:provides alerts
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance realtime_visualization : DTDFVocab:Service [
		DTDFVocab:provides system_monitoring, parts_visualization, violization_localization
		DTDFVocab:atStage baseDesc:operation
	]
	instance update_scheduler : DTDFVocab:Service [
		DTDFVocab:provides system_update
		DTDFVocab:atStage baseDesc:operation
	]
	instance runtime_monitor : DTDFVocab:Service [
		DTDFVocab:provides alerts, system_monitoring
		DTDFVocab:atStage baseDesc:operation
	]
	instance data_processing : DTDFVocab:Service [
//		DTDFVocab:provides
	]
	instance update_planning_simulation : DTDFVocab:Service [
		DTDFVocab:provides alerts, system_monitoring
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:hasTimeScale baseDesc:faster_trt
	]

	// ENABLERS
	instance grafana : DTDFVocab:Enabler [
		DTDFVocab:enables realtime_visualization
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance ml_model_updates : DTDFVocab:Enabler [
		DTDFVocab:enables virtual_moisture_detector
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance next_system_update : DTDFVocab:Enabler [
		DTDFVocab:enables update_scheduler
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance emqx : DTDFVocab:Enabler [
//		DTDFVocab:enables cement_stuck_detector, empty_hoppers_detector, virtual_moisture_detector, runtime_monitor, realtime_visualization, data_processing
	]
	instance kubernetes : DTDFVocab:Enabler [
//		DTDFVocab:enables 
	]
	instance cicd_pipelines : DTDFVocab:Enabler [
//		DTDFVocab:enables 
	]
	instance victoria_metrics : DTDFVocab:Enabler [
		DTDFVocab:enables realtime_visualization
	]
	
	
	// MODELS / DATA
	instance pt_telemetry : DTDFVocab:Data [
		DTDFVocab:inputTo emqx, next_system_update
		DTDFVocab:fromData pt:mixing_data, pt:event_data
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance historical_production_logs : DTDFVocab:Data [
		DTDFVocab:inputTo ml_model_updates, victoria_metrics
		DTDFVocab:fromData pt:mixing_data, pt:event_data
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance semi_markov_process_model : DTDFVocab:Model [
		DTDFVocab:inputTo next_system_update
		DTDFVocab:hasImplementation baseDesc:implemented
	]

	// INSIGHTS/ACTIONS
	instance system_monitoring : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance empty_hoppers_alert : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance alerts : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance violization_localization : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:planned
	]
	instance parts_visualization	 : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	instance system_update : DTDFVocab:Action [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:hasImplementation baseDesc:implemented
	]
	
	// DT CHARACTERISTICS
	
	// C5: Virtual to Physical Interaction
	instance virtual_to_physical : DTDFVocab:VirtualToPhysical [
		base:desc "Update scheduling decisions and alerts that influence PT operations."
	]
	
	// C7: TimeScale
	instance twinning_time_scale : DTDFVocab:TimeScaleDescription [
		base:desc "Real-time monitoring; Faster than real-time simulation for update planning."
	]
	
	// C8: Multiplicity
	instance multiplcity : DTDFVocab:Multiplicity [
		base:desc "Multiple CBPs monitored concurrently using identical DT service templates (End goal)"
	]
	
	// C9: LifeCycleStage
	instance life_cycle_stage : DTDFVocab:LifeCycleStage [
		base:desc "Software is updated on an ongoing basis."
	]
	
	// C12: Constellation
	instance constellation : DTDFVocab:Constellation [
		base:desc "(IDEA) One-to-many DT architecture with shared services and per-plant models."
	]
	
	// C13: EvolutionStage
	instance evol_stage : DTDFVocab:EvolutionStage [
		base:desc "Generation of a virtual sensor occurs offline, using new data to train it. Retest model as needed."
	]

	// C14: FidelityConsideration
	instance fidelity_consideration : DTDFVocab:FidelityConsideration [
		base:desc "Model accuracy depends on data quality."
	]
	
	// C15: TechnicalConnection
	instance technical_connection : DTDFVocab:TechnicalConnection [
		base:desc "Event-based streaming via message broker and containerized services."
	]
	
	// C16: DT hosting/deployment
	instance deployment : DTDFVocab:Deployment [
		base:desc "Cloud-hosted Kubernetes cluster with encryption between services, servers in different regions, and multiple different data-centers for high availability."
	]
	
	// C18: Horizontal Integration
	instance horizontal_integration : DTDFVocab:HoriIntegration [
		base:desc "N/A"
	]
	
	// C19: Data ownership and privacy	
	instance data_owneship_privacy : DTDFVocab:DataOwnershipPrivacy [
		base:desc "N/A"
	]
	
	// C20: Standardization
	instance standardization : DTDFVocab:Standardization [
		base:desc "N/A"
	]
	
	// C21: Security and safety considerations	
	instance security_safety : DTDFVocab:SecuritySafety [
		base:desc "Human-in-the-loop constraints."
	]
}