description <https://bentleyjoakes.github.io/fibo/fibo_pt#> as fibo_pt {
	
	uses <https://bentleyjoakes.github.io/DTDF/vocab/DTDFVocab#> as DTDFVocab

	uses <https://bentleyjoakes.github.io/DTDF/vocab/base#> as base
	extends <https://bentleyjoakes.github.io/DTDF/desc/baseDesc#> as baseDesc

	instance pt : DTDFVocab:SystemUnderStudy [
		DTDFVocab:hasSystem concrete_mixer
		DTDFVocab:hasAgent actor
		DTDFVocab:hasEnvironment plant
		base:desc "Concrete Batch Plant (CBP), fibo Collect self-service concrete mixing system."
	]
	
	instance concrete_mixer : DTDFVocab:System[
		DTDFVocab:purpose "Mix concrete"
		DTDFVocab:multiplicity 1
		base:contains mixer_rotor, motor, material_hoppers, payment_terminal, cement_silo, conveyor_mechanism, water_dosing_system
	]
	
	instance mixer_rotor : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance motor : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance material_hoppers : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance payment_terminal : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance cement_silo : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance conveyor_mechanism : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance water_dosing_system : DTDFVocab:ActingComponent [
		base:desc ""
	]
	
	instance motor_load_sensors : DTDFVocab:SensingComponent
	
	instance weight_sensors : DTDFVocab:SensingComponent
	
	instance temperature_sensors : DTDFVocab:SensingComponent
	
	instance humidity_sensors : DTDFVocab:SensingComponent
	
	instance mixing_data : DTDFVocab:DataTransmitted [
		DTDFVocab:producedFrom motor_load_sensors, weight_sensors, temperature_sensors, humidity_sensors
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:IsAutomatic true
	]
	
	instance event_data : DTDFVocab:DataTransmitted [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:IsAutomatic true
	]
	
	instance actor : DTDFVocab:Agent [
		base:desc ""
	]
	
	instance plant : DTDFVocab:Environment [
		base:contains location, weather
	]
	instance location : DTDFVocab:Component [
		base:desc "Where the concrete mixer is placed"
	]
	instance weather : DTDFVocab:Component [
		base:desc ""
	]
}
