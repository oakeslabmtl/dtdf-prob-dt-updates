description <https://bentleyjoakes.github.io/fibo/fibo_pt#> as fibo_pt {
	
	uses <https://bentleyjoakes.github.io/DTDF/vocab/DTDFVocab#> as DTDFVocab

	uses <https://bentleyjoakes.github.io/DTDF/vocab/base#> as base
	extends <https://bentleyjoakes.github.io/DTDF/desc/baseDesc#> as baseDesc

	instance pt : DTDFVocab:SystemUnderStudy [
		DTDFVocab:hasSystem ConcreteMixer
		DTDFVocab:hasAgent Actor
		DTDFVocab:hasEnvironment Plant
		base:desc "Concrete Batch Plant (CBP), fibo Collect self-service concrete mixing system."
	]
	
	instance ConcreteMixer : DTDFVocab:System[
		DTDFVocab:purpose "Mix concrete"
		DTDFVocab:multiplicity 1
		base:contains MixerRotor, Motor, MaterialHoppers, PaymentTerminal, CementSilo, ConveyorMechanism, WaterDosingSystem
	]
	
	instance MixerRotor : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance Motor : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance MaterialHoppers : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance PaymentTerminal : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance CementSilo : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance ConveyorMechanism : DTDFVocab:ActingComponent [
		base:desc ""
	]
	instance WaterDosingSystem : DTDFVocab:ActingComponent [
		base:desc ""
	]
	
	instance MotorLoadSensors : DTDFVocab:SensingComponent
	
	instance WeightSensors : DTDFVocab:SensingComponent
	
	instance TemperatureSensors : DTDFVocab:SensingComponent
	
	instance HumiditySensors : DTDFVocab:SensingComponent
	
	instance MixingData : DTDFVocab:DataTransmitted [
		DTDFVocab:producedFrom MotorLoadSensors, WeightSensors, TemperatureSensors, HumiditySensors
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:IsAutomatic true
	]
	
	instance EventData : DTDFVocab:DataTransmitted [
		DTDFVocab:hasTimeScale baseDesc:rt
		DTDFVocab:IsAutomatic true
	]
	
	instance Actor : DTDFVocab:Agent [
		base:desc ""
	]
	
	instance Plant : DTDFVocab:Environment [
		base:contains Location, Weather
	]
	instance Location : DTDFVocab:Component [
		base:desc "Where the concrete mixer is placed"
	]
	instance Weather : DTDFVocab:Component [
		base:desc ""
	]
}
